    {
      "pdfPage": 772,
      "type": "resolved source condition",
      "detail": "Original set S is not explicitly nonempty. Verified new adjacent Chinese note: S=empty gives E0=0, so augmentation cannot surject to Z."
    },
    {
      "pdfPage": 783,
      "type": "resolved source index",
      "detail": "Original second zero summand L_(i-1) is not a new domain summand; Chinese note identifies L_i from the explicitly printed direct sum, English retained."
    },
    {
      "pdfPage": 786,
      "type": "resolved source augmented complex",
      "detail": "Original K includes M tensor N; verified adjacent Chinese note excludes augmentation for Tor computation. Length-zero identity resolution with M=N=nonzero R gives an acyclic original K but Tor_0=R."
    },
    {
      "pdfPage": 787,
      "type": "resolved source scalar structure",
      "detail": "Verified adjacent Chinese note: Grothendieck ring construction supplies a Z-algebra, not automatic k-scalar action; trivial-group finite-dimensional example yields Z."
    },
    {
      "pdfPage": 790,
      "type": "resolved source generating series",
      "detail": "Verified printed constant1 conflicts with -t times logarithmic derivative; rank1 note and rank2 counterexample identify the finite source limitations without changing English."
    },
    {
      "pdfPage": 792,
      "type": "resolved source quantifier",
      "detail": "Verified adjacent Chinese note restricts divisible-group multiplication to nonzero integers; literal m=0 would force the group zero, contrary to following Q/Z example."
    },
    {
      "pdfPage": 795,
      "type": "resolved source proof wording",
      "detail": "Verified adjacent Chinese note: on cycles, f-g is a boundary d'h, while only hd vanishes; the whole difference need not vanish."
    },
    {
      "pdfPage": 797,
      "type": "resolved source quotient and extension maps",
      "detail": "Original first diagram f0 does not in general descend through E0/M; final adjacent note gives dprime0 f0 descent to I1. Original h1 extension and later h_(n+2) diagram omit the actual descending difference; both adjacent notes verified with complete homotopy calculation."
    },
    {
      "pdfPage": 799,
      "type": "resolved source extension order",
      "detail": "Source Ext1(A,M) defined from Hom(A,-) but printed0 to A to E to M to0 classifies Ext1(M,A). Final adjacent Chinese note gives correct order and Z,n nonsplit counterexample; English retained."
    },
    {
      "pdfPage": 800,
      "type": "resolved source derived variance",
      "detail": "Printed left derived for covariant invariant left-exact functor retained; adjacent Chinese note correctly identifies right-derived group cohomology from preceding definition and same-page sheaf example."
    },
    {
      "pdfPage": 801,
      "type": "resolved source connecting target",
      "detail": "Printed standalone delta target R^(n+1)F(M) missing prime retained; adjacent Chinese note identifies Mprime using immediately following sequence and naturality square."
    }
